{
  "opencollection": "1.0.0",
  "info": {
    "name": "Brooklinen Shopify Storefront JSON Collections API",
    "version": "2026-08-02"
  },
  "items": [
    {
      "info": {
        "name": "Collections",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List products in a collection",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.brooklinen.com/collections/:handle/products.json",
            "params": [
              {
                "name": "handle",
                "value": "dreamweave-waffle-robe-last-call",
                "type": "path",
                "description": "The URL handle of the resource."
              },
              {
                "name": "limit",
                "value": "1",
                "type": "query",
                "description": "Number of products to return per page."
              },
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "1-indexed page number."
              }
            ]
          },
          "docs": "Returns the published products in a merchandising collection. The `all` handle returns the full catalog."
        }
      ]
    }
  ],
  "bundled": true
}